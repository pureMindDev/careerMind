PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/careermind
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# AI provider (any OpenAI-compatible endpoint: OpenAI, OpenRouter, Groq, Together...)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Brevo (transactional email — password reset + email verification). Without
# BREVO_API_KEY, emails are logged to the console instead, so local dev
# doesn't need a real account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@careermind.ai
BREVO_SENDER_NAME=CareerMind AI
